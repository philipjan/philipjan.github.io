---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

<style>
  .carousel-container {
    scroll-behavior: smooth;
  }
  
  .carousel-scroll {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-right: 0.5rem;
  }
  
  .carousel-item {
    scroll-snap-align: start;
    flex-shrink: 0;
  }
  
  .carousel-item::-webkit-scrollbar {
    height: 6px;
  }
  
  .carousel-item::-webkit-scrollbar-track {
    background: rgb(30, 41, 59);
    border-radius: 3px;
  }
  
  .carousel-item::-webkit-scrollbar-thumb {
    background: rgb(71, 85, 105);
    border-radius: 3px;
  }
  
  .carousel-item::-webkit-scrollbar-thumb:hover {
    background: rgb(100, 116, 139);
  }

  .modal-overlay {
    animation: fadeIn 0.2s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .modal-sheet {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-slate-900">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-slate-50">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};
                const hasImages = project.images && project.images.length > 0;

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-4 sm:p-6 md:p-8 bg-slate-800 rounded-xl sm:rounded-2xl border border-slate-700 transition-all duration-300 ${
                        project.link
                          ? "hover:bg-slate-750 hover:shadow-xl hover:border-slate-600 hover:-translate-y-1"
                          : ""
                      }`}
                      data-has-carousel={hasImages ? "true" : "false"}
                    >
                      {project.link && (
                        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-slate-950 rounded-full text-white transition-all duration-300 group-hover:bg-slate-800 pointer-events-none">
                          <svg
                            class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-xl sm:text-2xl font-bold text-slate-50 mt-1">
                            {project.name}
                          </h3>
                        </div>

                        <p
                          class={`text-base sm:text-lg text-slate-400 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {hasImages && (
                          <div class="carousel-container pt-4 carousel-zone" data-project-index={index}>
                            <div class="carousel-scroll" data-project-index={index}>
                              {project.images.map((image, imgIndex) => (
                                <div class="carousel-item">
                                  <button
                                    type="button"
                                    class="relative group/img cursor-pointer carousel-btn"
                                    data-modal-id={`modal-${index}-${imgIndex}`}
                                  >
                                    <img
                                     src={image.startsWith('/') ? image : `/${image}`}
                                      alt={`${project.name} image ${imgIndex + 1}`}
                                      class="w-32 h-24 sm:w-40 sm:h-28 md:w-48 md:h-32 object-cover rounded-lg border border-slate-700 transition-all duration-300 group-hover/img:border-slate-600 group-hover/img:shadow-lg"
                                    />
                                    <div class="absolute inset-0 bg-black/40 rounded-lg opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                      <svg
                                        class="w-6 h-6 sm:w-7 sm:h-7 text-white"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                      >
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"
                                        />
                                      </svg>
                                    </div>
                                  </button>

                                  <div
                                    id={`modal-${index}-${imgIndex}`}
                                    class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center modal-container"
                                  >
                                    <div class="modal-overlay fixed inset-0 bg-black/60" onclick={(e) => {
                                      if (e.target === e.currentTarget) {
                                        e.currentTarget.closest('.modal-container')?.classList.add('hidden');
                                      }
                                    }} />
                                    <div class="modal-sheet relative bg-slate-800 rounded-t-2xl sm:rounded-2xl max-w-2xl w-full max-h-[80vh] overflow-auto border border-slate-700">
                                      <button
                                        type="button"
                                        class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center bg-slate-700 hover:bg-slate-600 rounded-full text-slate-200 transition-all duration-300 modal-close-btn"
                                        data-modal-id={`modal-${index}-${imgIndex}`}
                                      >
                                        <svg
                                          class="w-5 h-5"
                                          fill="none"
                                          stroke="currentColor"
                                          viewBox="0 0 24 24"
                                        >
                                          <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M6 18L18 6M6 6l12 12"
                                          />
                                        </svg>
                                      </button>
                                      <div class="p-6 sm:p-8">
                                        <img
                                          src={image.startsWith('/') ? image : `/${image}`}
                                          alt={`${project.name} image ${imgIndex + 1}`}
                                          class="w-full h-auto rounded-lg"
                                        />
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-slate-700 text-slate-200 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.link ? "group-hover:bg-slate-600" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Handle carousel image clicks and modal interactions
  document.querySelectorAll('.carousel-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const modalId = btn.getAttribute('data-modal-id');
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
      }
    });
  });

  // Handle modal close button clicks
  document.querySelectorAll('.modal-close-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const modalId = btn.getAttribute('data-modal-id');
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('hidden');
      }
    });
  });

  // Handle link hover state for carousel zones
  document.querySelectorAll('.carousel-zone').forEach(carousel => {
    const parentLink = carousel.closest('a');
    
    if (parentLink) {
      carousel.addEventListener('mouseenter', () => {
        parentLink.classList.remove('hover:bg-slate-750', 'hover:shadow-xl', 'hover:border-slate-600', 'hover:-translate-y-1');
      });

      carousel.addEventListener('mouseleave', () => {
        parentLink.classList.add('hover:bg-slate-750', 'hover:shadow-xl', 'hover:border-slate-600', 'hover:-translate-y-1');
      });

      // Prevent link navigation when clicking carousel
      carousel.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
      });
    }
  });
</script>
