---
import { siteConfig } from "../config";
---

<section id="contact" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-slate-900">
  <div class="flex flex-col items-center text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-slate-50">
      Contact
    </h2>
    <div
      class="w-[75px] h-[5px] mt-2 rounded-full"
      style={`background-color: ${siteConfig.accentColor}`}
    />

    <div class="mt-12 flex flex-wrap justify-center gap-3">
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-slate-800 border border-slate-700 rounded-full text-sm font-medium text-slate-200">
        <span
          class="inline-block w-2 h-2 rounded-full pulse-dot"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        Remote
      </span>
      <span class="px-4 py-2 bg-slate-800 border border-slate-700 rounded-full text-sm font-medium text-slate-200">
        Full-time
      </span>
      <span class="px-4 py-2 bg-slate-800 border border-slate-700 rounded-full text-sm font-medium text-slate-200">
        Contract
      </span>
    </div>

    <p class="mt-6 max-w-xl text-base sm:text-lg text-slate-400 leading-relaxed">
      I'm currently open to new opportunities and would love to hear about your project.
      Drop me a line and let's build something great together.
    </p>

    <a
      href={`mailto:${siteConfig.social.email}`}
      class="group mt-10 inline-flex items-center gap-3 text-2xl sm:text-3xl md:text-4xl font-bold transition-all duration-300 hover:scale-105"
      style={`color: ${siteConfig.accentColor}`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-7 w-7 sm:h-8 sm:w-8 md:h-9 md:w-9 flex-shrink-0 transition-transform duration-300 group-hover:translate-x-1"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
        <path d="M3 7l9 6l9 -6" />
      </svg>
      {siteConfig.social.email}
    </a>
  </div>
</section>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .pulse-dot {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
